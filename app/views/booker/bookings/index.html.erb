<% content_for :hide_booking_back_link, true %>

<div class="booking-header">
  <h1 class="booking-header-title">Espace utilisateur</h1>
  <p class="booking-header-subtitle">Vos reservations confirmees</p>
</div>

<div class="booking-summary">
  <div class="booking-summary-row">
    <span class="booking-summary-label">Reservations affichees</span>
    <span class="booking-summary-value"><%= @bookings.size %></span>
  </div>
</div>

<div class="booking-actions">
  <div class="booking-actions-primary">
    <% if @reserve_path.present? %>
      <%= link_to "Reserver", @reserve_path, class: "btn-primary btn-primary--compact" %>
    <% else %>
      <p class="booking-section-meta">Aucun client disponible pour demarrer une reservation.</p>
    <% end %>
  </div>
</div>

<div class="booking-section">
  <div class="booking-section-header">
    <h2 class="booking-section-title">Historique confirme</h2>
  </div>
  <div class="booking-section-content">
    <div class="booking-table-wrapper">
      <table class="booking-table">
        <thead>
          <tr>
            <th>Client</th>
            <th>Enseigne</th>
            <th>Service</th>
            <th>Statut</th>
            <th>Debut</th>
          </tr>
        </thead>
        <tbody>
          <% @bookings.each do |booking| %>
            <tr>
              <td><%= booking.client.name %></td>
              <td><%= booking.enseigne.name %></td>
              <td><%= booking.service.name %></td>
              <td><span class="booking-status-pill"><%= booking.booking_status %></span></td>
              <td><%= format_datetime_label(booking.booking_start_time) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
