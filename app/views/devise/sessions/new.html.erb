<% content_for :title, "Connexion | Webook4u" %>
<% content_for :hide_booking_auth_bar, true %>

<%= render "shared/page_header",
           title: "Se connecter",
           subtitle: "Accédez à votre espace pour reprendre votre réservation et gérer vos rendez-vous." %>

<div class="booking-section">
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "booking-auth-form" }) do |f| %>
    <div class="field">
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input", placeholder: "vous@exemple.com" %>
    </div>

    <div class="field">
      <%= f.label :password, "Mot de passe", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "field-input", placeholder: "Votre mot de passe" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <label class="booking-checkbox">
          <%= f.check_box :remember_me %>
          <span>Rester connecté</span>
        </label>
      </div>
    <% end %>

    <div class="booking-actions booking-actions--center">
      <%= f.submit "Connexion", class: "btn-primary btn-primary--large" %>
    </div>
  <% end %>

  <div class="booking-auth-links">
    <%= render "devise/shared/auth_links" %>
  </div>
</div>
