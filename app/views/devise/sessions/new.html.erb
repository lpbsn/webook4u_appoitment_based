<% content_for :title, "Connexion | Webook4u" %>
<% content_for :hide_booking_auth_bar, true %>

<div class="booking-header">
  <h1 class="booking-header-title">Se connecter</h1>
  <p class="booking-header-subtitle">Accédez à votre espace pour reprendre votre réservation et gérer vos rendez-vous.</p>
</div>

<div class="booking-section">
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "booking-auth-form" }) do |f| %>
    <div class="field">
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input", placeholder: "vous@exemple.com" %>
    </div>

    <div class="field">
      <%= f.label :password, "Mot de passe", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "field-input", placeholder: "Votre mot de passe" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <label class="booking-checkbox">
          <%= f.check_box :remember_me %>
          <span>Rester connecté</span>
        </label>
      </div>
    <% end %>

    <div class="booking-actions booking-actions--center">
      <%= f.submit "Connexion", class: "btn-primary btn-primary--large" %>
    </div>
  <% end %>

  <div class="booking-auth-links">
  <% if controller_name != "sessions" %>
    <%= link_to "Se connecter",
                new_session_path(resource_name, redirect_to: params[:redirect_to].presence || session[:after_auth_redirect_to]),
                class: "booking-inline-link" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Créer un compte",
                new_registration_path(resource_name, redirect_to: params[:redirect_to].presence || session[:after_auth_redirect_to]),
                class: "booking-inline-link" %>
  <% end %>
  </div>
</div>
