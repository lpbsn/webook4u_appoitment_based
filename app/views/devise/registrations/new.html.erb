<% content_for :title, "Inscription | Webook4u" %>
<% content_for :hide_booking_auth_bar, true %>

<div class="booking-header">
  <h1 class="booking-header-title">Créer un compte</h1>
  <p class="booking-header-subtitle">Créez votre accès pour poursuivre votre réservation dans la même interface que le parcours booking.</p>
</div>

<div class="booking-section">
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "booking-auth-form" }) do |f| %>
    <% if resource.errors.any? %>
      <%= render "shared/error_list",
                 messages: resource.errors.full_messages,
                 title: "Le formulaire contient des erreurs :" %>
    <% end %>

    <div class="field">
      <%= f.label :last_name, "Nom", class: "field-label" %>
      <%= f.text_field :last_name, autocomplete: "family-name", class: "field-input", placeholder: "Votre nom", required: true %>
    </div>

    <div class="field">
      <%= f.label :first_name, "Prénom", class: "field-label" %>
      <%= f.text_field :first_name, autocomplete: "given-name", class: "field-input", placeholder: "Votre prénom", required: true %>
    </div>

    <div class="field">
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input", placeholder: "vous@exemple.com" %>
    </div>

    <div class="field">
      <%= f.label :password, "Mot de passe", class: "field-label" %>
      <% if @minimum_password_length %>
        <div class="booking-section-meta"><%= @minimum_password_length %> caractères minimum</div>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "field-input", placeholder: "Choisissez un mot de passe" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", placeholder: "Retapez votre mot de passe" %>
    </div>

    <div class="booking-actions booking-actions--center">
      <%= f.submit "Créer mon compte", class: "btn-primary btn-primary--large" %>
    </div>
  <% end %>

  <div class="booking-auth-links">
  <% if controller_name != "sessions" %>
    <%= link_to "Se connecter",
                new_session_path(resource_name, redirect_to: params[:redirect_to].presence || session[:after_auth_redirect_to]),
                class: "booking-inline-link" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Créer un compte",
                new_registration_path(resource_name, redirect_to: params[:redirect_to].presence || session[:after_auth_redirect_to]),
                class: "booking-inline-link" %>
  <% end %>
  </div>
</div>
