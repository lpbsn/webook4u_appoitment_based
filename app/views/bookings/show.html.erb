<% content_for :hide_booking_back_link, true %>

<%= render "shared/page_header", title: @client.name, subtitle: "#{@enseigne.name} — #{@service.name}" %>

<p class="booking-section-meta">
  Montant à payer : <%= format_price_cents(@service.price_cents) %>
</p>

<%= render "booking_summary" %>

<% if @booking.errors.any? %>
  <%= render "shared/error_list",
             messages: @booking.errors.full_messages,
             title: "Le formulaire contient des erreurs :" %>
<% end %>

<%= render "confirmation_form" %>
