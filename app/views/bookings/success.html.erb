<% content_for :hide_booking_back_link, true %>

<section class="booking-success-body" aria-label="Détails de la réservation confirmée">
  <h1 class="booking-success-title">Votre réservation est confirmée</h1>
  <p><strong>Client :</strong> <%= @client.name %></p>
  <p><strong>Enseigne :</strong> <%= booking_enseigne_name(@booking) %></p>
  <p><strong>Adresse :</strong> <%= booking_enseigne_address(@booking) %></p>
  <p><strong>Booker :</strong> <%= booking_customer_name(@booking) %></p>
  <p><strong>Email :</strong> <%= booking_masked_customer_email(@booking) %></p>
  <p><strong>Prestation :</strong> <%= @service.name %></p>
  <p><strong>Montant à payer :</strong> <%= format_price_cents(@service.price_cents) %></p>
  <p><strong>Créneau :</strong> <%= booking_formatted_slot(@booking) %></p>
</section>
