<% content_for :booking_back_href, admin_clients_path %>

<div class="booking-header">
  <h1 class="booking-header-title">Nouveau Client — Création guidée</h1>
  <p class="booking-header-subtitle">Étape <%= @step %>/4</p>
</div>

<div class="booking-section">
  <div class="booking-wizard-progress" aria-label="Progression du wizard">
    <% (1..4).each do |wizard_step| %>
      <% segment_class =
        if wizard_step_completed?(wizard_step)
          "booking-wizard-progress-segment booking-wizard-progress-segment--done"
        elsif wizard_step == @step
          "booking-wizard-progress-segment booking-wizard-progress-segment--current"
        else
          "booking-wizard-progress-segment"
        end %>
      <span class="<%= segment_class %>"></span>
    <% end %>
  </div>

  <div class="booking-tabs">
    <% [1, 2, 3, 4].each do |wizard_step| %>
      <% tab_classes = ["booking-tab"] %>
      <% tab_classes << "booking-tab--active" if @step == wizard_step %>
      <% tab_classes << "booking-tab--done" if wizard_step_completed?(wizard_step) %>
      <span class="<%= tab_classes.join(' ') %>">
        Étape <%= wizard_step %>
        <% if wizard_step_completed?(wizard_step) %>
          <span class="booking-tab-state">validée</span>
        <% elsif @step == wizard_step %>
          <span class="booking-tab-state">en cours</span>
        <% end %>
      </span>
    <% end %>
  </div>
</div>

<% if @step_errors.present? %>
  <%= render "shared/error_list",
             messages: @step_errors,
             title: "Le formulaire contient des erreurs.",
             wrapper_class: "booking-alert booking-alert--error",
             title_tag: "p" %>
<% end %>

<div class="booking-section">
  <% if @step == 1 %>
    <% if @client_form.errors.any? %>
      <%= render "shared/error_list",
                 messages: @client_form.errors.full_messages,
                 title: "Le formulaire contient des erreurs.",
                 wrapper_class: "booking-alert booking-alert--error",
                 title_tag: "p" %>
    <% end %>

    <%= form_with url: admin_clients_path, method: :post, local: true do %>
      <%= hidden_field_tag :creation_step, 1 %>

      <div class="booking-dynamic-block">
        <div class="field field--compact">
          <%= label_tag "client_name", "Nom du client", class: "field-label" %>
          <%= text_field_tag "client[name]", @client_form.name, class: "field-input field-input--short", required: true, id: "client_name" %>
        </div>

        <div class="field field--compact">
          <%= label_tag "client_slug", "Slug", class: "field-label" %>
          <%= text_field_tag "client[slug]", @client_form.slug, class: "field-input field-input--short", required: true, id: "client_slug" %>
        </div>
      </div>

      <div class="booking-actions">
        <%= submit_tag "Suivant", class: "btn-primary btn-primary--compact" %>
      </div>
    <% end %>
  <% elsif @step == 2 %>
    <%= form_with url: admin_clients_path, method: :post, local: true do %>
      <%= hidden_field_tag :creation_step, 2 %>

      <div id="enseigne-fields-container">
        <% @enseignes_draft_entries.each do |enseigne| %>
          <% idx = enseigne["ui_index"] %>
          <%= render "admin/clients/new/enseigne_fields",
                     idx: idx,
                     index_label: idx + 1,
                     enseigne: enseigne,
                     hide_trash: @enseignes_draft_entries.size <= 1 %>
        <% end %>
      </div>

      <template id="enseigne-block-template">
        <%= render "admin/clients/new/enseigne_fields",
                   idx: "__INDEX__",
                   index_label: "__INDEX_LABEL__",
                   template_mode: true %>
      </template>

      <div class="booking-actions">
        <button type="button" class="booking-topbar-button" id="add-enseigne-button">+ Enseigne</button>
      </div>

      <div class="booking-actions">
        <%= link_to "Précédent", new_admin_client_path(step: 1), class: "booking-topbar-link" %>
        <%= submit_tag "Suivant", class: "btn-primary btn-primary--compact" %>
      </div>
    <% end %>
  <% elsif @step == 3 %>
    <% if @service_form.errors.any? %>
      <%= render "shared/error_list",
                 messages: @service_form.errors.full_messages,
                 title: "Le formulaire contient des erreurs.",
                 wrapper_class: "booking-alert booking-alert--error",
                 title_tag: "p" %>
    <% end %>

    <%= form_with url: admin_clients_path, method: :post, local: true do %>
      <%= hidden_field_tag :creation_step, 3 %>

      <div class="booking-dynamic-block">
        <div class="field field--compact">
          <%= label_tag "service_name", "Nom du service", class: "field-label" %>
          <%= text_field_tag "service[name]", @service_form.name, class: "field-input field-input--short", required: true, id: "service_name" %>
        </div>

        <div class="field field--compact">
          <%= label_tag "service_duration_minutes", "Durée (minutes)", class: "field-label" %>
          <%= number_field_tag "service[duration_minutes]", @service_form.duration_minutes, class: "field-input field-input--short", min: 1, required: true, id: "service_duration_minutes" %>
        </div>

        <div class="field field--compact">
          <%= label_tag "service_price_cents", "Prix (centimes)", class: "field-label" %>
          <%= number_field_tag "service[price_cents]", @service_form.price_cents, class: "field-input field-input--short", min: 0, required: true, id: "service_price_cents" %>
        </div>
      </div>

      <div class="booking-actions">
        <%= link_to "Précédent", new_admin_client_path(step: 2), class: "booking-topbar-link" %>
        <%= submit_tag "Suivant", class: "btn-primary btn-primary--compact" %>
      </div>
    <% end %>
  <% elsif @step == 4 %>
    <% if @staff_form.errors.any? %>
      <%= render "shared/error_list",
                 messages: @staff_form.errors.full_messages,
                 title: "Le formulaire contient des erreurs.",
                 wrapper_class: "booking-alert booking-alert--error",
                 title_tag: "p" %>
    <% end %>

    <div class="booking-summary">
      <h2 class="booking-section-title">Récapitulatif avant création définitive</h2>
      <div class="booking-summary-row">
        <span class="booking-summary-label">Client</span>
        <span class="booking-summary-value"><%= "#{@draft.dig("client", "name")} (#{@draft.dig("client", "slug")})" %></span>
      </div>
      <% Array(@draft["enseignes"]).each_with_index do |enseigne, index| %>
        <% formatted_address = Enseigne.new(address: enseigne["address"], postal_code: enseigne["postal_code"], city: enseigne["city"]).formatted_address %>
        <% enseigne_value = "#{enseigne["name"]}#{formatted_address.present? ? " — #{formatted_address}" : ""}" %>
        <div class="booking-summary-row">
          <span class="booking-summary-label">Enseigne <%= index + 1 %></span>
          <span class="booking-summary-value"><%= enseigne_value %></span>
        </div>
      <% end %>
      <% service_value = "#{@draft.dig("service_template", "name")}, #{@draft.dig("service_template", "duration_minutes")} min, #{@draft.dig("service_template", "price_cents")} centimes" %>
      <div class="booking-summary-row">
        <span class="booking-summary-label">Service</span>
        <span class="booking-summary-value"><%= service_value %></span>
      </div>
    </div>

    <%= form_with url: admin_clients_path, method: :post, local: true do %>
      <%= hidden_field_tag :creation_step, 4 %>
      <% enseignes_options = Array(@draft["enseignes"]).each_with_index.map { |enseigne, i| ["#{i + 1}. #{enseigne["name"]}", i] } %>

      <div id="staff-fields-container">
        <% @staffs_draft_entries.each do |staff| %>
          <% idx = staff["ui_index"] %>
          <%= render "admin/clients/new/staff_fields",
                     idx: idx,
                     index_label: idx + 1,
                     staff: staff,
                     hide_trash: @staffs_draft_entries.size <= 1,
                     enseignes_options: enseignes_options %>
        <% end %>
      </div>

      <template id="staff-block-template">
        <%= render "admin/clients/new/staff_fields",
                   idx: "__INDEX__",
                   index_label: "__INDEX_LABEL__",
                   template_mode: true,
                   enseignes_options: enseignes_options %>
      </template>

      <div class="booking-actions">
        <button type="button" class="booking-topbar-button" id="add-staff-button">+ Staff</button>
      </div>

      <div class="booking-actions">
        <%= link_to "Précédent", new_admin_client_path(step: 3), class: "booking-topbar-link" %>
        <%= submit_tag "Créer le Client", class: "btn-primary btn-primary--compact" %>
      </div>
    <% end %>
  <% end %>
</div>
