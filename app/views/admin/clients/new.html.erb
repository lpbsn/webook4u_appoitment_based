<% content_for :booking_back_href, admin_clients_path %>

<%= render "shared/page_header",
           title: "Nouveau Client — Création guidée",
           subtitle: "Étape #{@step}/4" %>

<div class="booking-section">
  <div class="booking-wizard-progress" aria-label="Progression du wizard">
    <% (1..4).each do |wizard_step| %>
      <% segment_class =
        if wizard_step_completed?(wizard_step)
          "booking-wizard-progress-segment booking-wizard-progress-segment--done"
        elsif wizard_step == @step
          "booking-wizard-progress-segment booking-wizard-progress-segment--current"
        else
          "booking-wizard-progress-segment"
        end %>
      <span class="<%= segment_class %>"></span>
    <% end %>
  </div>

  <div class="booking-tabs">
    <% [1, 2, 3, 4].each do |wizard_step| %>
      <% tab_classes = ["booking-tab"] %>
      <% tab_classes << "booking-tab--active" if @step == wizard_step %>
      <% tab_classes << "booking-tab--done" if wizard_step_completed?(wizard_step) %>
      <span class="<%= tab_classes.join(' ') %>">
        Étape <%= wizard_step %>
        <% if wizard_step_completed?(wizard_step) %>
          <span class="booking-tab-state">validée</span>
        <% elsif @step == wizard_step %>
          <span class="booking-tab-state">en cours</span>
        <% end %>
      </span>
    <% end %>
  </div>
</div>

<% if @step_errors.present? %>
  <%= render "shared/error_list",
             messages: @step_errors,
             title: "Le formulaire contient des erreurs.",
             wrapper_class: "booking-alert booking-alert--error",
             title_tag: "p" %>
<% end %>

<div class="booking-section">
  <% step_partial = {
    1 => "admin/clients/new/step_client",
    2 => "admin/clients/new/step_enseignes",
    3 => "admin/clients/new/step_service",
    4 => "admin/clients/new/step_staffs"
  }[@step] %>
  <%= render step_partial if step_partial.present? %>
</div>
