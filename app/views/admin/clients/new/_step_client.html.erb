<% if @client_form.errors.any? %>
  <%= render "shared/error_list",
             messages: @client_form.errors.full_messages,
             title: "Le formulaire contient des erreurs.",
             wrapper_class: "booking-alert booking-alert--error",
             title_tag: "p" %>
<% end %>

<%= form_with url: admin_clients_path, method: :post, local: true do %>
  <%= hidden_field_tag :creation_step, 1 %>

  <div class="booking-dynamic-block">
    <div class="field field--compact">
      <%= label_tag "client_name", "Nom du client", class: "field-label" %>
      <%= text_field_tag "client[name]", @client_form.name, class: "field-input field-input--short", required: true, id: "client_name" %>
    </div>

    <div class="field field--compact">
      <%= label_tag "client_slug", "Slug", class: "field-label" %>
      <%= text_field_tag "client[slug]", @client_form.slug, class: "field-input field-input--short", required: true, id: "client_slug" %>
    </div>
  </div>

  <div class="booking-actions">
    <%= submit_tag "Suivant", class: "btn-primary btn-primary--compact" %>
  </div>
<% end %>
