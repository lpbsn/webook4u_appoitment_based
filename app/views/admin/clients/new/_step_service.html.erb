<% if @service_form.errors.any? %>
  <%= render "shared/error_list",
             messages: @service_form.errors.full_messages,
             title: "Le formulaire contient des erreurs.",
             wrapper_class: "booking-alert booking-alert--error",
             title_tag: "p" %>
<% end %>

<%= form_with url: admin_clients_path, method: :post, local: true do %>
  <%= hidden_field_tag :creation_step, 3 %>

  <div class="booking-dynamic-block">
    <div class="field field--compact">
      <%= label_tag "service_name", "Nom du service", class: "field-label" %>
      <%= text_field_tag "service[name]", @service_form.name, class: "field-input field-input--short", required: true, id: "service_name" %>
    </div>

    <div class="field field--compact">
      <%= label_tag "service_duration_minutes", "Durée (minutes)", class: "field-label" %>
      <%= number_field_tag "service[duration_minutes]", @service_form.duration_minutes, class: "field-input field-input--short", min: 1, required: true, id: "service_duration_minutes" %>
    </div>

    <div class="field field--compact">
      <%= label_tag "service_price_cents", "Prix (centimes)", class: "field-label" %>
      <%= number_field_tag "service[price_cents]", @service_form.price_cents, class: "field-input field-input--short", min: 0, required: true, id: "service_price_cents" %>
    </div>
  </div>

  <div class="booking-actions">
    <%= link_to "Précédent", new_admin_client_path(step: 2), class: "booking-topbar-link" %>
    <%= submit_tag "Suivant", class: "btn-primary btn-primary--compact" %>
  </div>
<% end %>
