<div class="booking-header">
  <h1 class="booking-header-title">Comptes client</h1>
  <p class="booking-header-subtitle">Gestion des utilisateurs rattachés aux clients métier</p>
</div>

<div class="booking-summary">
  <div class="booking-summary-row">
    <span class="booking-summary-label">Comptes client affichés</span>
    <span class="booking-summary-value"><%= @client_users.size %></span>
  </div>
</div>

<div class="booking-actions">
  <div class="booking-actions-primary">
    <%= link_to "Nouveau ClientUser", @new_user_path, class: "btn-primary btn-primary--compact" %>
  </div>
  <div class="booking-actions-secondary">
    <%= link_to "Retour réservations admin", admin_bookings_path, class: "booking-topbar-link" %>
  </div>
</div>

<div class="booking-section">
  <div class="booking-section-header">
    <h2 class="booking-section-title">Liste des comptes client</h2>
  </div>
  <div class="booking-section-content">
    <div class="booking-table-wrapper">
      <table class="booking-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Nom</th>
            <th>Client</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @client_users.each do |client_user| %>
            <tr>
              <td><%= client_user.email %></td>
              <td><%= client_user.first_name %> <%= client_user.last_name %></td>
              <td><%= client_user.client&.name || "-" %></td>
              <td>
                <span class="booking-status-pill">
                  <%= client_user.active? ? "actif" : "inactif" %>
                </span>
              </td>
              <td>
                <div class="booking-actions booking-actions--row">
                  <%= link_to "Modifier", edit_admin_user_path(client_user), class: "booking-topbar-link" %>
                  <%= button_to(
                    client_user.active? ? "Désactiver" : "Activer",
                    toggle_active_admin_user_path(client_user),
                    method: :patch,
                    class: "booking-topbar-button"
                  ) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
