<% assignment_complete =
     @assignment_mode == "automatic" ||
     (@assignment_mode == "specific_staff" && @selected_staff.present?) %>

<% if @selected_enseigne.present? && @selected_service.present? && assignment_complete && @search_mode == "precise_date" %>
  <div class="booking-section">
    <h2 class="booking-section-title">5. Choisir un créneau</h2>
    <div class="booking-section-meta">
      <strong><%= @selected_enseigne.name %></strong> —
      <strong><%= @selected_service.name %></strong> -
      <strong><%= @selected_service.duration_minutes %>'</strong>
    </div>
    <p class="booking-section-meta">Parcourez les prochains jours et sélectionnez directement l’horaire qui vous convient.</p>

    <% planning_start_date = @date || BookingRules.business_today %>
    <% previous_start_date = planning_start_date - 7.days %>
    <% next_start_date = planning_start_date + 7.days %>
    <% max_planning_date = BookingRules.business_today + BookingRules.max_future_days.days %>
    <% can_go_previous = previous_start_date >= BookingRules.business_today %>
    <% can_go_next = next_start_date <= max_planning_date %>

    <div class="booking-planning-toolbar">
      <% if can_go_previous %>
        <%= form_with url: public_client_path(@client.slug), method: :get, local: true do %>
          <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
          <%= hidden_field_tag :service_id, @selected_service.id %>
          <%= hidden_field_tag :assignment_mode, @assignment_mode %>
          <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
            <%= hidden_field_tag :staff_id, @selected_staff.id %>
          <% end %>
          <%= hidden_field_tag :search_mode, @search_mode %>
          <%= hidden_field_tag :date, previous_start_date.iso8601 %>
          <%= submit_tag "Semaine précédente", class: "booking-planning-nav-button" %>
        <% end %>
      <% else %>
        <span class="booking-planning-nav-button booking-planning-nav-button--disabled">Semaine précédente</span>
      <% end %>

      <span class="booking-planning-range">
        <%= planning_start_date.strftime("%d/%m/%Y") %> -
        <%= [planning_start_date + 6.days, max_planning_date].min.strftime("%d/%m/%Y") %>
      </span>

      <% if can_go_next %>
        <%= form_with url: public_client_path(@client.slug), method: :get, local: true do %>
          <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
          <%= hidden_field_tag :service_id, @selected_service.id %>
          <%= hidden_field_tag :assignment_mode, @assignment_mode %>
          <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
            <%= hidden_field_tag :staff_id, @selected_staff.id %>
          <% end %>
          <%= hidden_field_tag :search_mode, @search_mode %>
          <%= hidden_field_tag :date, next_start_date.iso8601 %>
          <%= submit_tag "Semaine suivante", class: "booking-planning-nav-button" %>
        <% end %>
      <% else %>
        <span class="booking-planning-nav-button booking-planning-nav-button--disabled">Semaine suivante</span>
      <% end %>
    </div>

    <div class="booking-planning" aria-label="Créneaux disponibles">
      <% @precise_date_days.each do |day| %>
        <section class="booking-planning-day">
          <header class="booking-planning-day-header">
            <span class="booking-planning-day-name"><%= day_of_week_label(day.date.wday) %></span>
            <span class="booking-planning-day-date"><%= day.date.strftime("%d/%m") %></span>
          </header>

          <% if day.slots.any? %>
            <div class="booking-planning-slots">
              <% day.slots.each do |slot| %>
                <%= form_tag public_client_path(@client.slug), method: :get do %>
                  <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
                  <%= hidden_field_tag :service_id, @selected_service.id %>
                  <%= hidden_field_tag :assignment_mode, @assignment_mode %>
                  <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
                    <%= hidden_field_tag :staff_id, @selected_staff.id %>
                  <% end %>
                  <%= hidden_field_tag :search_mode, @search_mode %>
                  <%= hidden_field_tag :date, day.date.iso8601 %>
                  <%= hidden_field_tag :selected_start_time, slot %>
                  <%= submit_tag public_client_slot_label(slot),
                        class: ["booking-planning-slot", ("booking-planning-slot--selected" if @selected_start_time.to_s == slot.to_s)].compact.join(" ") %>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="booking-planning-empty">Aucun créneau</p>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
