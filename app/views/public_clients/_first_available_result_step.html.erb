<% assignment_complete = @assignment_mode == "automatic" || (@assignment_mode == "specific_staff" && @selected_staff.present?) %>

<% if @selected_enseigne.present? &&
      @selected_service.present? &&
      assignment_complete &&
      @search_mode == "first_available" &&
      @first_available_search_performed %>
  <div class="booking-section">
    <h2 class="booking-section-title">6. Premier créneau disponible</h2>
    <div class="booking-section-meta">
      <strong><%= @selected_enseigne.name %></strong> —
      <strong><%= @selected_service.name %></strong> -
      <strong><%= @selected_service.duration_minutes %>'</strong>
    </div>

    <div class="booking-alert">
      <% if @first_available_slot.present? %>
        <p>
          Créneau suggéré :
          <strong><%= l(@first_available_slot.to_date, format: :long) %></strong>
          à
          <strong><%= @first_available_slot.strftime("%H:%M") %></strong>
        </p>

        <%= form_tag service_bookings_path(@client.slug, @selected_service), method: :post do %>
          <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
          <%= hidden_field_tag :start_time, @first_available_slot %>
          <%= hidden_field_tag :assignment_mode, @assignment_mode %>
          <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
            <%= hidden_field_tag :staff_id, @selected_staff.id %>
          <% end %>
          <%= hidden_field_tag :search_mode, @search_mode %>
          <% Array(@first_available_selected_days_of_week).each do |day| %>
            <%= hidden_field_tag "selected_days_of_week[]", day %>
          <% end %>
          <%= hidden_field_tag :start_time_min, @first_available_start_time_min %>
          <%= hidden_field_tag :start_time_max, @first_available_start_time_max %>
          <div class="booking-actions booking-actions--center">
            <%= submit_tag "Continuer avec ce créneau", class: "btn-primary btn-primary--compact" %>
          </div>
        <% end %>
      <% else %>
        <p>Aucun créneau disponible ne correspond à vos critères.</p>
      <% end %>
    </div>
  </div>
<% end %>
