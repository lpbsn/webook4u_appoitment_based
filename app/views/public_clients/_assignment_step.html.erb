<% if @selected_enseigne.present? && @selected_service.present? %>
  <div class="booking-section">
    <h2 class="booking-section-title">3. Choisir le staff</h2>
    <p class="booking-section-meta">Sélectionner un staff</p>

    <% if @eligible_staffs.any? %>
      <div class="slot-grid slot-grid--staff-list">
        <%= render "choice_form",
              url: public_client_path(@client.slug),
              hidden_fields: {
                enseigne_id: @selected_enseigne.id,
                service_id: @selected_service.id,
                assignment_mode: "automatic"
              },
              label: "Tous",
              selected: @assignment_mode == "automatic",
              button_classes: "slot-button" %>

        <% @eligible_staffs.each do |staff| %>
          <%= render "choice_form",
                url: public_client_path(@client.slug),
                hidden_fields: {
                  enseigne_id: @selected_enseigne.id,
                  service_id: @selected_service.id,
                  assignment_mode: "specific_staff",
                  staff_id: staff.id
                },
                label: staff.name,
                selected: @selected_staff&.id == staff.id,
                button_classes: ["slot-button", "slot-button--staff"] %>
        <% end %>
      </div>
    <% else %>
      <p>Aucun collaborateur éligible n'est disponible pour cette prestation.</p>
    <% end %>
  </div>
<% end %>
