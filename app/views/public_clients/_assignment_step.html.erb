<% if @selected_enseigne.present? && @selected_service.present? %>
  <div class="booking-section">
    <h2 class="booking-section-title">3. Choisir le staff</h2>
    <p class="booking-section-meta">Sélectionner un staff</p>

    <% if @eligible_staffs.any? %>
      <div class="slot-grid slot-grid--staff-list">
        <%= form_with url: public_client_path(@client.slug), method: :get, local: true do %>
          <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
          <%= hidden_field_tag :service_id, @selected_service.id %>
          <%= hidden_field_tag :assignment_mode, "automatic" %>
          <%= submit_tag "Premier disponible", class: ["slot-button", ("slot-button--selected" if @assignment_mode == "automatic")].compact.join(" ") %>
        <% end %>

        <% @eligible_staffs.each do |staff| %>
          <%= form_with url: public_client_path(@client.slug), method: :get, local: true do %>
            <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
            <%= hidden_field_tag :service_id, @selected_service.id %>
            <%= hidden_field_tag :assignment_mode, "specific_staff" %>
            <%= hidden_field_tag :staff_id, staff.id %>
            <%= submit_tag staff.name, class: ["slot-button", "slot-button--staff", ("slot-button--selected" if @selected_staff&.id == staff.id)].compact.join(" ") %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p>Aucun collaborateur éligible n'est disponible pour cette prestation.</p>
    <% end %>
  </div>
<% end %>
