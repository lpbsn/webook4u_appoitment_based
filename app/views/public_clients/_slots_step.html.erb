<% assignment_complete = @assignment_mode == "automatic" || (@assignment_mode == "specific_staff" && @selected_staff.present?) %>

<% if @selected_enseigne.present? && @selected_service.present? && @date.present? && assignment_complete && @search_mode == "precise_date" %>
  <div class="booking-section">
    <h2 class="booking-section-title">6. Choisir un créneau</h2>
    <p class="booking-section-meta">Sélectionnez l’horaire qui vous convient.</p>

    <% if @slots.any? %>
      <div class="slot-grid">
        <% @slots.each do |slot| %>
          <%= form_tag public_client_path(@client.slug), method: :get do %>
            <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
            <%= hidden_field_tag :service_id, @selected_service.id %>
            <%= hidden_field_tag :assignment_mode, @assignment_mode %>
            <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
              <%= hidden_field_tag :staff_id, @selected_staff.id %>
            <% end %>
            <%= hidden_field_tag :search_mode, @search_mode %>
            <%= hidden_field_tag :date, @date %>
            <%= hidden_field_tag :selected_start_time, slot %>
            <%= submit_tag public_client_slot_label(slot), class: "slot-button" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p>Aucun créneau n'est disponible pour cette date. Veuillez choisir une autre date.</p>
    <% end %>
  </div>
<% end %>
