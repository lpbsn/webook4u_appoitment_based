<div class="booking-section">
  <h2 class="booking-section-title">1. Choisir une enseigne</h2>
  <p class="booking-section-meta">Sélectionner le lieu de votre rendez-vous.</p>

  <% if @enseignes.any? %>
    <div class="slot-grid">
      <% @enseignes.each do |enseigne| %>
        <% selected = @selected_enseigne&.id == enseigne.id %>
        <%= render "choice_form",
              url: public_client_path(@client.slug),
              hidden_fields: { enseigne_id: enseigne.id },
              label: enseigne.name,
              selected: selected,
              button_classes: "slot-button" %>
      <% end %>
    </div>
  <% else %>
    <p>Aucune enseigne active n'est disponible pour le moment.</p>
  <% end %>
</div>
