<% selected = local_assigns.fetch(:selected, false) %>
<% button_classes = Array(local_assigns.fetch(:button_classes, "slot-button")).flatten.compact %>
<% hidden_fields = local_assigns.fetch(:hidden_fields, {}) %>

<%= form_with url: url, method: :get, local: true do |form| %>
  <%= public_flow_hidden_fields_tags({}, hidden_fields) %>
  <%= form.submit label, class: [*button_classes, ("slot-button--selected" if selected)].compact.join(" ") %>
<% end %>
