<% form_url = local_assigns.fetch(:url) %>
<% label = local_assigns.fetch(:label) %>
<% selected = local_assigns.fetch(:selected, false) %>
<% button_classes = Array(local_assigns.fetch(:button_classes, "slot-button")).flatten.compact %>
<% hidden_fields = local_assigns.fetch(:hidden_fields, {}) %>

<%= form_with url: form_url, method: :get, local: true do %>
  <%= render "flow_hidden_fields", source: {}, overrides: hidden_fields %>

  <%= submit_tag label, class: [*button_classes, ("slot-button--selected" if selected)].compact.join(" ") %>
<% end %>
