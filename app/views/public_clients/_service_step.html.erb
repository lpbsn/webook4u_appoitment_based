<% if @selected_enseigne.present? %>
<div class="booking-section">
  <h2 class="booking-section-title">2. Choisir un service</h2>
  <p class="booking-section-meta">Sélectionnez le service qui vous convient.</p>

  <div class="slot-grid">
    <% @services.each do |service| %>
      <% selected = @selected_service&.id == service.id %>
      <%= render "choice_form",
            url: public_client_path(@client.slug),
            hidden_fields: { enseigne_id: @selected_enseigne.id, service_id: service.id },
            label: service.name,
            selected: selected,
            button_classes: "slot-button" %>
    <% end %>
  </div>
</div>
<% end %>
