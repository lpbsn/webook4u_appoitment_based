<% assignment_complete =
     @assignment_mode == "automatic" ||
     (@assignment_mode == "specific_staff" && @selected_staff.present?) %>

<% if @selected_enseigne.present? &&
      @selected_service.present? &&
      assignment_complete &&
      @search_mode == "first_available" %>
  <div class="booking-section">
    <h2 class="booking-section-title">5. Définir vos critères</h2>
    <div class="booking-section-meta">
      <strong><%= @selected_enseigne.name %></strong> —
      <strong><%= @selected_service.name %></strong> -
      <strong><%= @selected_service.duration_minutes %>'</strong>
    </div>
    <p class="booking-section-meta">Choisissez les jours et la plage horaire souhaités.</p>

    <% if @first_available_errors.present? %>
      <div class="booking-alert booking-alert--error">
        <ul>
          <% @first_available_errors.each_value do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: public_client_path(@client.slug), method: :get, local: true do %>
      <%= hidden_field_tag :enseigne_id, @selected_enseigne.id %>
      <%= hidden_field_tag :service_id, @selected_service.id %>
      <%= hidden_field_tag :assignment_mode, @assignment_mode %>
      <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
        <%= hidden_field_tag :staff_id, @selected_staff.id %>
      <% end %>
      <%= hidden_field_tag :search_mode, @search_mode %>

      <div class="field">
        <span class="field-label">Jours souhaités</span>
        <div class="slot-grid slot-grid--staff-list">
          <% @first_available_available_days_of_week.each do |day_of_week| %>
            <% checkbox_id = "selected_days_of_week_#{day_of_week}" %>
            <label for="<%= checkbox_id %>" class="slot-button">
              <%= check_box_tag "selected_days_of_week[]",
                                day_of_week,
                                @first_available_selected_days_of_week.include?(day_of_week),
                                id: checkbox_id %>
              <span><%= Date::DAYNAMES[day_of_week] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="start_time_min">Heure de début minimale</label>
        <%= time_field_tag :start_time_min,
                           @first_available_start_time_min,
                           required: false,
                           class: "field-input" %>
      </div>

      <div class="field">
        <label class="field-label" for="start_time_max">Heure de début maximale</label>
        <%= time_field_tag :start_time_max,
                           @first_available_start_time_max,
                           required: false,
                           class: "field-input" %>
      </div>

      <%= submit_tag "Rechercher", class: "btn-primary" %>
    <% end %>
  </div>
<% end %>
