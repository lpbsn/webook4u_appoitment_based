<% assignment_complete = @assignment_mode == "automatic" || (@assignment_mode == "specific_staff" && @selected_staff.present?) %>

<% if @selected_enseigne.present? &&
      @selected_service.present? &&
      @selected_start_time.present? &&
      assignment_complete &&
      @search_mode == "precise_date" %>
  <% confirmation_hidden_fields = {
       enseigne_id: @selected_enseigne.id,
       assignment_mode: @assignment_mode,
       search_mode: @search_mode
     } %>
  <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
    <% confirmation_hidden_fields[:staff_id] = @selected_staff.id %>
  <% end %>
  <% if @search_mode == "precise_date" && @date.present? %>
    <% confirmation_hidden_fields[:date] = @date %>
  <% end %>

  <div class="booking-section">
    <h2 class="booking-section-title">7. Confirmer le créneau</h2>
    <p class="booking-section-meta">
      Vous avez sélectionné :
        <strong><%= format_date_label(Time.zone.parse(@selected_start_time.to_s)) %></strong>
        à
        <strong><%= format_time_label(Time.zone.parse(@selected_start_time.to_s)) %></strong>
    </p>

    <%= form_tag service_bookings_path(@client.slug, @selected_service), method: :post, data: { turbo_frame: "_top" } do %>
      <%= hidden_field_tag :start_time, @selected_start_time %>
      <%= render "flow_hidden_fields", source: {}, overrides: confirmation_hidden_fields %>

      <div class="booking-actions booking-actions--center">
        <%= submit_tag "Confirmer ce créneau", class: "btn-primary btn-primary--large" %>
      </div>
    <% end %>
  </div>
<% end %>
