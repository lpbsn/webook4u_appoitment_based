<% assignment_complete =
     @assignment_mode == "automatic" ||
     (@assignment_mode == "specific_staff" && @selected_staff.present?) %>

<% if @selected_enseigne.present? && @selected_service.present? && assignment_complete %>
  <div class="booking-section">
    <h2 class="booking-section-title">4. Choisir le mode de recherche</h2>
    <div class="booking-section-meta">
      <strong><%= @selected_enseigne.name %></strong> —
      <strong><%= @selected_service.name %></strong> -
      <strong><%= @selected_service.duration_minutes %>'</strong>
    </div>
    <p class="booking-section-meta">Choisissez comment rechercher votre rendez-vous.</p>

    <% assignment_hidden_fields = { enseigne_id: @selected_enseigne.id, service_id: @selected_service.id, assignment_mode: @assignment_mode } %>
    <% if @assignment_mode == "specific_staff" && @selected_staff.present? %>
      <% assignment_hidden_fields[:staff_id] = @selected_staff.id %>
    <% end %>

    <div class="slot-grid slot-grid--staff-list">
      <%= render "choice_form",
            url: public_client_path(@client.slug),
            hidden_fields: assignment_hidden_fields.merge(search_mode: "first_available"),
            label: "Premier créneau disponible",
            selected: @search_mode == "first_available",
            button_classes: "slot-button" %>

      <%= render "choice_form",
            url: public_client_path(@client.slug),
            hidden_fields: assignment_hidden_fields.merge(search_mode: "precise_date"),
            label: "Date précise",
            selected: @search_mode == "precise_date",
            button_classes: "slot-button" %>
    </div>
  </div>
<% end %>
