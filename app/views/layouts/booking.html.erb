<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/app_shell_head" %>
  </head>

  <body class="booking-body">
    <div class="booking-page">
      <% unless content_for?(:hide_booking_auth_bar) %>
        <div class="booking-topbar">
          <% if user_signed_in? %>
            <% personal_space_path =
              case current_user.role
              when "admin"
                admin_root_path
              when "client_user"
                client_root_path
              else
                user_root_path
              end %>
            <span><%= current_user.email %></span>
            <%= link_to "🏠 Home", personal_space_path, class: "booking-topbar-link" %>
            <%= button_to "Se déconnecter",
                          destroy_user_session_path(redirect_to: request.fullpath),
                          method: :delete,
                          class: "booking-topbar-button" %>
          <% else %>
            <%= link_to "Créer un compte",
                        new_user_registration_path(redirect_to: request.fullpath),
                        class: "booking-topbar-link" %>
            <%= link_to "Se connecter",
                        new_user_session_path(redirect_to: request.fullpath),
                        class: "booking-topbar-link" %>
          <% end %>
        </div>
      <% end %>

      <div class="booking-card <%= content_for?(:booking_card_modifier) ? yield(:booking_card_modifier) : '' %>">
        <% unless content_for?(:hide_booking_back_link) %>
          <% explicit_back_href = content_for?(:booking_back_href) ? content_for(:booking_back_href).to_s.strip : "" %>
          <% back_href = explicit_back_href.presence || request.referer.presence || "#" %>
          <div class="booking-card-back">
            <%= link_to "←",
                        back_href,
                        class: "booking-back-link",
                        title: "Retour",
                        data: { turbo: false },
                        onclick: "if(this.getAttribute('href')==='#'){history.back(); return false;}" %>
          </div>
        <% end %>

        <% if notice.present? %>
          <div class="booking-alert booking-alert--notice">
            <p><%= notice %></p>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="booking-alert booking-alert--error">
            <p><%= alert %></p>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </div>
  </body>
</html>
