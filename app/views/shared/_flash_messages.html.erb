<% variant = local_assigns.fetch(:variant, :default) %>
<% flash_entries = [
  { message: notice, kind: :notice, role: "status", live: "polite", booking_modifier: "notice" },
  { message: alert, kind: :alert, role: "alert", live: "assertive", booking_modifier: "error" }
] %>

<% flash_entries.each do |entry| %>
  <% next if entry[:message].blank? %>
  <% if variant == :booking %>
    <div class="booking-alert booking-alert--<%= entry[:booking_modifier] %>" role="<%= entry[:role] %>" aria-live="<%= entry[:live] %>" aria-atomic="true">
      <p><%= entry[:message] %></p>
    </div>
  <% else %>
    <p role="<%= entry[:role] %>" aria-live="<%= entry[:live] %>" aria-atomic="true"><%= entry[:message] %></p>
  <% end %>
<% end %>
